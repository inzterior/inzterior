# Google Sheets — leads pipeline
# Service account credentials from Google Cloud Console (Sheets API enabled).
# Share the target Sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=leads-writer@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_NAME=Leads

# Resend — optional email notification on new lead (Sheet still saves without this)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL="Inzterior Leads <leads@inzterior.com>"
LEADS_NOTIFY_EMAIL=inquiry@inzterior.com
